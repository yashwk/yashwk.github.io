---
// src/components/SiteNav.astro
// Unified top navigation bar across all pages
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';
const isProjects = currentPath.startsWith('/projects');
const isBlog = currentPath.startsWith('/blog');
---

<nav class="site-nav-header" aria-label="Main Navigation">
  <div class="site-nav-inner">
    <a
      href="/"
      class:list={['site-brand', { active: isHome }]}
      aria-label="Yashwanth Home"
      aria-current={isHome ? 'page' : undefined}
    >
      <span class="brand-bracket">[</span><span class="brand-name">Yashwanth</span><span class="brand-bracket">]</span>
    </a>

    <div class="site-nav-links">
      <a
        href="/projects/"
        class:list={['site-nav-link', { active: isProjects }]}
        aria-current={isProjects ? 'page' : undefined}
      >
        Projects
      </a>
      <a
        href="/blog/"
        class:list={['site-nav-link', { active: isBlog }]}
        aria-current={isBlog ? 'page' : undefined}
      >
        Writing
      </a>
      <a
        href="/rss.xml"
        class="site-nav-link"
        title="Subscribe via RSS feed"
        target="_blank"
        rel="noopener noreferrer"
      >
        RSS
      </a>
      <a
        href="https://github.com/yashwk"
        class="site-nav-link site-nav-github"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        title="GitHub @yashwk"
      >
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
</nav>

<style>
.site-nav-header {
  margin-bottom: 2.25rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--border);
}

.site-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.site-brand {
  font-family: var(--font-mono);
  font-size: 0.95rem;
  font-weight: 600;
  color: #ffffff;
  text-decoration: none;
  letter-spacing: -0.01em;
  display: inline-flex;
  align-items: center;
  gap: 0.15rem;
  transition: opacity 0.15s ease;
}

.site-brand:hover {
  opacity: 0.85;
  color: #ffffff;
}

.brand-bracket {
  color: var(--accent);
  font-weight: 700;
}

.brand-name {
  color: #ffffff;
}

.site-nav-links {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.site-nav-link {
  font-family: var(--font-mono);
  font-size: 0.84rem;
  color: var(--text-muted);
  text-decoration: none;
  padding: 0.25rem 0.55rem;
  border-radius: 4px;
  border: 1px solid transparent;
  transition: all 0.15s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
}

.site-nav-link:hover {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.05);
  transform: translateY(-1px);
}

.site-nav-link:active {
  transform: translateY(0);
}

.site-nav-link.active {
  color: var(--accent);
  background: rgba(88, 166, 255, 0.1);
  border-color: rgba(88, 166, 255, 0.25);
  font-weight: 600;
}

.site-nav-github svg {
  display: inline-block;
  vertical-align: middle;
}

@media (max-width: 480px) {
  .site-nav-inner {
    flex-direction: column;
    align-items: flex-start;
  }
  .site-nav-links {
    width: 100%;
    justify-content: flex-start;
    gap: 0.25rem;
  }
}
</style>
