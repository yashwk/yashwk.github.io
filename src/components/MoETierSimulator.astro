---
// src/components/MoETierSimulator.astro
// Interactive MoE Inference & Tiered Memory Simulator for Mosaic
---

<div class="moe-simulator-container">
  <div class="moe-header">
    <div class="moe-dots">
      <span class="dot dot-red"></span>
      <span class="dot dot-yellow"></span>
      <span class="dot dot-green"></span>
    </div>
    <div class="moe-title">
      mosaic moe-tier-simulator | Qwen3.6-35B-A3B (40 Layers × 256 Experts) on 8 GiB VRAM
    </div>
    <div class="moe-badge">AVX2 + Tensor Core</div>
  </div>

  <div class="moe-controls-bar">
    <div class="moe-control-group">
      <button id="moe-play-btn" class="moe-action-btn primary" type="button">
        ▶ Stream Generation
      </button>
      <button id="moe-step-btn" class="moe-action-btn" type="button">
        Step Token (+1)
      </button>
      <button id="moe-flush-btn" class="moe-action-btn" type="button">
        ↺ Flush VRAM LRU
      </button>
    </div>

    <div class="moe-control-group">
      <label for="moe-context-slider">Context:</label>
      <input type="range" id="moe-context-slider" min="128" max="32768" value="2048" step="128" class="moe-slider" />
      <span id="moe-context-val" class="moe-val-chip">2,048 tok</span>
    </div>
  </div>

  <div class="moe-body">
    <!-- Top row: Hardware Memory Tiers -->
    <div class="moe-tiers-grid">
      <!-- Tier 1: NVMe -->
      <div class="moe-tier-card">
        <div class="tier-header">
          <span class="tier-name">1. NVMe SSD Backing</span>
          <span class="tier-speed">~3.5 GB/s</span>
        </div>
        <div class="tier-value">35.0 GB</div>
        <div class="tier-sub">40 layer shards (`.safetensors`) zero-copy mmap</div>
        <div class="tier-progress-track">
          <div class="tier-progress-bar disk" style="width: 100%;"></div>
        </div>
      </div>

      <!-- Tier 2: Kernel Page Cache -->
      <div class="moe-tier-card">
        <div class="tier-header">
          <span class="tier-name">2. Linux Page Cache</span>
          <span class="tier-speed">`madvise`</span>
        </div>
        <div class="tier-value" id="moe-ram-val">8.4 GiB / 14 GiB</div>
        <div class="tier-sub">Faulted expert working set; auto-managed by OS</div>
        <div class="tier-progress-track">
          <div class="tier-progress-bar ram" id="moe-ram-bar" style="width: 60%;"></div>
        </div>
      </div>

      <!-- Tier 3: CPU SIMD Executor -->
      <div class="moe-tier-card">
        <div class="tier-header">
          <span class="tier-name">3. C++ AVX2 Executor</span>
          <span class="tier-speed">~0.08 ms / exp</span>
        </div>
        <div class="tier-value" id="moe-cpu-val">Cold Path (&lt;3 hits)</div>
        <div class="tier-sub">Inline E4M3 arithmetic dequant & FMA vectors</div>
        <div class="tier-progress-track">
          <div class="tier-progress-bar cpu" id="moe-cpu-bar" style="width: 35%;"></div>
        </div>
      </div>

      <!-- Tier 4: GPU VRAM LRU Cache -->
      <div class="moe-tier-card highlight">
        <div class="tier-header">
          <span class="tier-name">4. GPU VRAM Cache</span>
          <span class="tier-speed" style="color: #34d399;">RTX 4060 (8 GiB)</span>
        </div>
        <div class="tier-value" id="moe-vram-val" style="color: #34d399;">4.15 GiB / 8.00 GiB</div>
        <div class="tier-sub" id="moe-lru-sub">Promoted recurring experts (≥3 hits)</div>
        <div class="tier-progress-track">
          <div class="tier-progress-bar vram" id="moe-vram-bar" style="width: 52%;"></div>
        </div>
      </div>
    </div>

    <!-- Live Telemetry Matrix -->
    <div class="moe-telemetry-row">
      <div class="moe-stream-col">
        <div class="stream-title">Simulated Generation Stream:</div>
        <div class="stream-output" id="moe-stream-text">
          <span class="token-history">Explain kernel vs cooperative scheduling: </span>
          <span class="token-current" id="moe-active-token">In</span>
          <span class="cursor-blink">▌</span>
        </div>
      </div>

      <div class="moe-metrics-col">
        <div class="metric-pill">
          <span class="metric-label">VRAM Hit Rate</span>
          <span class="metric-val" id="moe-hit-rate" style="color: #34d399;">78.4%</span>
        </div>
        <div class="metric-pill">
          <span class="metric-label">Decode Speed</span>
          <span class="metric-val" id="moe-speed-val">2.82 tok/s</span>
        </div>
        <div class="metric-pill">
          <span class="metric-label">Attention Latency</span>
          <span class="metric-val" id="moe-atten-val">58 ms (Flat O(1))</span>
        </div>
        <div class="metric-pill">
          <span class="metric-label">Cold Fallbacks</span>
          <span class="metric-val" id="moe-cold-count">2 / 8 experts</span>
        </div>
      </div>
    </div>

    <!-- Router Visualization: 8 Selected Experts for Active Token -->
    <div class="moe-router-viz">
      <div class="router-header">
        <span>Active Layer Router (Top-8 Experts Dispatched):</span>
        <span class="router-legend">
          <span class="dot-legend vram-dot"></span> GPU VRAM Hit
          <span class="dot-legend cpu-dot" style="margin-left: 0.75rem;"></span> CPU Page-Cache Cold
        </span>
      </div>
      <div class="router-experts-grid" id="moe-experts-grid">
        <!-- Populated via script -->
      </div>
    </div>
  </div>

  <div class="moe-footer">
    <span class="moe-status-indicator">
      <span class="pulse-indicator"></span>
      <span id="moe-status-text">READY · Model Weights: 40 Layers Sharded mmap</span>
    </span>
    <span class="moe-meta-text">
      Zero PyTorch Heap Overhead | Inline Blockwise FP8 (128×128 scale_inv)
    </span>
  </div>
</div>

<style>
.moe-simulator-container {
  background: #0d1117;
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
  margin: 2rem 0;
  box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.5);
  font-family: var(--font-mono);
}

.moe-header {
  background: #161b22;
  padding: 0.65rem 1rem;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 0.8rem;
  color: var(--text-muted);
}

.moe-dots {
  display: flex;
  gap: 6px;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
}

.dot-red { background: #ff5f56; }
.dot-yellow { background: #ffbd2e; }
.dot-green { background: #27c93f; }

.moe-title {
  color: #c9d1d9;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}

.moe-badge {
  font-size: 0.7rem;
  background: rgba(16, 185, 129, 0.15);
  color: #34d399;
  border: 1px solid rgba(16, 185, 129, 0.35);
  padding: 0.15rem 0.5rem;
  border-radius: 4px;
  font-weight: 600;
}

.moe-controls-bar {
  background: #12161c;
  padding: 0.65rem 1rem;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.moe-control-group {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.78rem;
  color: var(--text-muted);
}

.moe-action-btn {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border);
  color: var(--text);
  font-family: var(--font-mono);
  font-size: 0.76rem;
  padding: 0.3rem 0.65rem;
  border-radius: 4px;
  cursor: pointer;
  transition: all 0.15s ease;
}

.moe-action-btn:hover {
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
}

.moe-action-btn.primary {
  background: rgba(16, 185, 129, 0.15);
  border-color: rgba(16, 185, 129, 0.4);
  color: #34d399;
}

.moe-action-btn.primary:hover {
  background: rgba(16, 185, 129, 0.25);
  color: #ffffff;
}

.moe-slider {
  width: 110px;
  accent-color: #34d399;
  cursor: pointer;
}

.moe-val-chip {
  background: #1c2128;
  padding: 0.2rem 0.45rem;
  border-radius: 3px;
  color: #34d399;
  font-size: 0.74rem;
  border: 1px solid var(--border);
}

.moe-body {
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.moe-tiers-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.75rem;
}

.moe-tier-card {
  background: #12161c;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 0.7rem 0.85rem;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.moe-tier-card.highlight {
  border-color: rgba(52, 211, 153, 0.4);
  background: rgba(16, 185, 129, 0.04);
}

.tier-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 0.72rem;
  color: var(--text-dim);
}

.tier-speed {
  font-size: 0.68rem;
  color: var(--accent);
}

.tier-value {
  font-size: 1.05rem;
  font-weight: 700;
  color: #ffffff;
}

.tier-sub {
  font-size: 0.68rem;
  color: var(--text-muted);
  line-height: 1.35;
  margin-bottom: 0.25rem;
}

.tier-progress-track {
  height: 6px;
  background: #1c2128;
  border-radius: 3px;
  overflow: hidden;
  margin-top: auto;
}

.tier-progress-bar {
  height: 100%;
  border-radius: 3px;
  transition: width 0.3s ease;
}

.tier-progress-bar.disk { background: #3b82f6; }
.tier-progress-bar.ram { background: #8b5cf6; }
.tier-progress-bar.cpu { background: #f59e0b; }
.tier-progress-bar.vram { background: #10b981; }

.moe-telemetry-row {
  display: flex;
  gap: 1.25rem;
  flex-wrap: wrap;
}

.moe-stream-col {
  flex: 1 1 360px;
  background: #12161c;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 0.75rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.stream-title {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--text-dim);
}

.stream-output {
  font-size: 0.88rem;
  line-height: 1.5;
  color: var(--text);
  min-height: 52px;
}

.token-history {
  color: var(--text-muted);
}

.token-current {
  color: #34d399;
  font-weight: 700;
  background: rgba(16, 185, 129, 0.15);
  padding: 0 3px;
  border-radius: 2px;
}

.cursor-blink {
  color: #34d399;
  animation: blink 1s step-start infinite;
}

@keyframes blink {
  50% { opacity: 0; }
}

.moe-metrics-col {
  flex: 0 0 240px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.6rem;
}

.metric-pill {
  background: #12161c;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 0.5rem 0.65rem;
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.metric-label {
  font-size: 0.66rem;
  text-transform: uppercase;
  color: var(--text-dim);
}

.metric-val {
  font-size: 0.95rem;
  font-weight: 700;
  color: #ffffff;
}

.moe-router-viz {
  background: #12161c;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 0.75rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.router-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.72rem;
  color: var(--text-muted);
}

.router-legend {
  font-size: 0.68rem;
  display: flex;
  align-items: center;
}

.dot-legend {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  display: inline-block;
  margin-right: 4px;
}

.vram-dot { background: #10b981; }
.cpu-dot { background: #f59e0b; }

.router-experts-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 0.5rem;
}

.expert-chip {
  background: #1c2128;
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 0.4rem 0.3rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.expert-chip.is-vram {
  border-color: rgba(52, 211, 153, 0.6);
  background: rgba(16, 185, 129, 0.12);
}

.expert-chip.is-cpu {
  border-color: rgba(245, 158, 11, 0.4);
  background: rgba(245, 158, 11, 0.08);
}

.expert-id {
  font-size: 0.74rem;
  font-weight: 700;
  color: #ffffff;
}

.expert-tier {
  font-size: 0.62rem;
}

.expert-chip.is-vram .expert-tier { color: #34d399; }
.expert-chip.is-cpu .expert-tier { color: #f59e0b; }

.moe-footer {
  background: #161b22;
  padding: 0.55rem 1rem;
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.72rem;
  color: var(--text-muted);
  flex-wrap: wrap;
  gap: 0.5rem;
}

.moe-status-indicator {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  color: #c9d1d9;
}

.pulse-indicator {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #10b981;
  box-shadow: 0 0 8px #10b981;
}

@media (max-width: 768px) {
  .moe-tiers-grid {
    grid-template-columns: 1fr 1fr;
  }
  .router-experts-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}
</style>

<script is:inline>
(function() {
  const TOKENS_SCRIPT = [
    "A", "kernel", "scheduler", "runs", "in", "privileged", "ring 0,",
    "using", "hardware", "timer", "interrupts", "to", "preemptively", "context",
    "switch", "threads.", "In", "contrast,", "a", "userspace", "cooperative",
    "scheduler", "relies", "on", "tasks", "explicitly", "yielding", "control,",
    "eliminating", "lock", "contention", "and", "avoiding", "costly", "TLB",
    "invalidations", "across", "memory", "spaces."
  ];

  let tokenIdx = 0;
  let isStreaming = false;
  let streamTimer = null;
  let hitCount = 18;
  let totalSteps = 24;
  let vramPromotedExperts = new Set([12, 45, 88, 102, 143, 201, 219]); // Pre-warmed hot experts

  function stepToken() {
    tokenIdx = (tokenIdx + 1) % TOKENS_SCRIPT.length;
    const curWord = TOKENS_SCRIPT[tokenIdx];

    // Pick top-8 experts for this token
    const activeExperts = [];
    let stepHits = 0;

    for (let i = 0; i < 8; i++) {
      // Semi-random expert id
      const expId = ((tokenIdx * 7 + i * 31) % 256);
      const isHit = vramPromotedExperts.has(expId) || (Math.random() < 0.75);

      if (isHit) {
        vramPromotedExperts.add(expId);
        stepHits++;
      }
      activeExperts.push({ id: expId, isHit });
    }

    hitCount += stepHits;
    totalSteps += 8;

    // Update UI elements
    const tokenEl = document.getElementById('moe-active-token');
    if (tokenEl) tokenEl.innerText = curWord;

    const hitRateEl = document.getElementById('moe-hit-rate');
    const speedEl = document.getElementById('moe-speed-val');
    const coldCountEl = document.getElementById('moe-cold-count');
    const statusText = document.getElementById('moe-status-text');

    const rate = ((hitCount / totalSteps) * 100).toFixed(1);
    if (hitRateEl) hitRateEl.innerText = `${rate}%`;

    const coldNum = 8 - stepHits;
    if (coldCountEl) coldCountEl.innerText = `${coldNum} / 8 (${stepHits} GPU hits)`;

    // Speed depends on hits
    const tokSpeed = (1.8 + (stepHits / 8) * 1.2).toFixed(2);
    if (speedEl) speedEl.innerText = `${tokSpeed} tok/s`;

    if (statusText) {
      statusText.innerText = `DECODING · Token ${tokenIdx + 1}/${TOKENS_SCRIPT.length} · ${tokSpeed} tok/s`;
    }

    // Render 8 active experts
    const grid = document.getElementById('moe-experts-grid');
    if (grid) {
      grid.innerHTML = '';
      activeExperts.forEach((exp) => {
        const div = document.createElement('div');
        div.className = `expert-chip ${exp.isHit ? 'is-vram' : 'is-cpu'}`;
        div.innerHTML = `
          <span class="expert-id">E#${exp.id}</span>
          <span class="expert-tier">${exp.isHit ? 'GPU VRAM' : 'CPU AVX2'}</span>
        `;
        grid.appendChild(div);
      });
    }

    // Update VRAM gauge
    const vramUsedGiB = (3.8 + (vramPromotedExperts.size / 256) * 0.8).toFixed(2);
    const vramEl = document.getElementById('moe-vram-val');
    const vramBar = document.getElementById('moe-vram-bar');
    if (vramEl) vramEl.innerText = `${vramUsedGiB} GiB / 8.00 GiB`;
    if (vramBar) vramBar.style.width = `${((vramUsedGiB / 8.0) * 100).toFixed(0)}%`;
  }

  function init() {
    const playBtn = document.getElementById('moe-play-btn');
    const stepBtn = document.getElementById('moe-step-btn');
    const flushBtn = document.getElementById('moe-flush-btn');
    const slider = document.getElementById('moe-context-slider');
    const ctxVal = document.getElementById('moe-context-val');
    const attenVal = document.getElementById('moe-atten-val');

    if (playBtn) {
      playBtn.onclick = () => {
        if (isStreaming) {
          clearInterval(streamTimer);
          isStreaming = false;
          playBtn.innerText = '▶ Stream Generation';
        } else {
          isStreaming = true;
          playBtn.innerText = '⏸ Pause Stream';
          streamTimer = setInterval(stepToken, 420);
        }
      };
    }

    if (stepBtn) {
      stepBtn.onclick = () => {
        if (isStreaming) {
          clearInterval(streamTimer);
          isStreaming = false;
          if (playBtn) playBtn.innerText = '▶ Stream Generation';
        }
        stepToken();
      };
    }

    if (flushBtn) {
      flushBtn.onclick = () => {
        vramPromotedExperts.clear();
        hitCount = 0;
        totalSteps = 1;
        stepToken();
      };
    }

    if (slider && ctxVal) {
      slider.oninput = (e) => {
        const val = parseInt(e.target.value, 10);
        ctxVal.innerText = `${val.toLocaleString()} tok`;
        // Linear attention latency is flat (~58-64 ms)
        const ms = (56 + (val / 32768) * 8).toFixed(0);
        if (attenVal) attenVal.innerText = `${ms} ms (Flat O(1))`;
      };
    }

    // Initial render
    stepToken();
  }

  document.addEventListener('astro:page-load', () => {
    init();
  });
})();
</script>
