---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import TerminalCockpit from '../../components/TerminalCockpit.astro';
import RcsPolarPlot from '../../components/RcsPolarPlot.astro';
import TerrainCompressionSandbox from '../../components/TerrainCompressionSandbox.astro';
import MoETierSimulator from '../../components/MoETierSimulator.astro';

// Master toggle: set to false to completely disable all interactive demos across the site
const SHOW_INTERACTIVE_DEMOS = true;

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  return allProjects.map((project) => ({
    params: { slug: project.id },
    props: { project, allProjects },
  }));
}

interface Props {
  project: any;
  allProjects: any[];
}

const { project, allProjects } = Astro.props;
const { Content } = await render(project);

// Other projects for bottom cross-links
const otherProjects = allProjects.filter((p) => p.id !== project.id);
---

<BaseLayout
  title={`${project.data.name} - Project Overview`}
  description={project.data.tagline}
  image={`/og/project-${project.id}.png`}
  showProgress={true}
  type="software"
  repo={project.data.repo}
  tags={project.data.tags}
>
  <nav class="breadcrumb-nav" style="margin-bottom: 1.5rem;">
    <a href="/projects/">&larr; Back to all projects</a>
  </nav>

  <header class="project-detail-hero">
    <img
      src={project.data.icon}
      alt={`${project.data.name} Logo`}
      class="project-hero-icon"
      width="64"
      height="64"
      loading="eager"
    />
    <div class="project-hero-content">
      <h1 class="project-hero-title">{project.data.name}</h1>
      <p class="project-hero-tagline">{project.data.tagline}</p>
      <div class="project-hero-actions">
        <a href={project.data.repo} target="_blank" rel="noopener noreferrer" class="btn-primary">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          View on GitHub
        </a>
        {project.data.blogSlug && (
          <a href={`/blog/${project.data.blogSlug}/`} class="btn-secondary">
            Read Blog Post &rarr;
          </a>
        )}
      </div>
    </div>
  </header>

  {SHOW_INTERACTIVE_DEMOS && (
    <>
      {project.id === 'strikeengine' && (
        <details class="project-demo-drawer" open>
          <summary class="demo-drawer-summary">
            <span class="demo-summary-left">
              <span>⚡ Live Simulation Telemetry Cockpit (<code>strike monitor</code>)</span>
            </span>
            <span class="demo-badge">Click to Toggle</span>
          </summary>
          <div class="demo-drawer-content">
            <p style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 0.75rem;">
              Real-time flight kinematics and guidance telemetry for an 80 km head-on BVR engagement (Astra MK2 vs. Su-30 Flanker):
            </p>
            <TerminalCockpit />
          </div>
        </details>
      )}

      {project.id === 'strikecem' && (
        <details class="project-demo-drawer" open>
          <summary class="demo-drawer-summary">
            <span class="demo-summary-left">
              <span>⚡ Live 360° Polar Radar Cross Section (RCS) Scope</span>
            </span>
            <span class="demo-badge">Click to Toggle</span>
          </summary>
          <div class="demo-drawer-content">
            <p style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 0.75rem;">
              Asymptotic Physical Optics (PO) + Physical Theory of Diffraction (PTD) fringe wave RCS simulator. Toggle targets, sweep azimuth angles, and inspect polarization response:
            </p>
            <RcsPolarPlot />
          </div>
        </details>
      )}

      {project.id === 'libxtm' && (
        <details class="project-demo-drawer" open>
          <summary class="demo-drawer-summary">
            <span class="demo-summary-left">
              <span>⚡ Live DEM Terrain Compression & Predictor Sandbox</span>
            </span>
            <span class="demo-badge">Click to Toggle</span>
          </summary>
          <div class="demo-drawer-content">
            <p style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 0.75rem;">
              Evaluating the 6 deterministic spatial predictors on 32×32 terrain tiles. Toggle quadtree subdivision, split-precision planes, and inspect residual Shannon entropy:
            </p>
            <TerrainCompressionSandbox />
          </div>
        </details>
      )}

      {project.id === 'mosaic' && (
        <details class="project-demo-drawer" open>
          <summary class="demo-drawer-summary">
            <span class="demo-summary-left">
              <span>⚡ Live MoE Tiered Memory Hierarchy Simulator</span>
            </span>
            <span class="demo-badge">Click to Toggle</span>
          </summary>
          <div class="demo-drawer-content">
            <p style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 0.75rem;">
              Simulating Qwen3.6-35B inference across NVMe disk, Linux page cache, C++ AVX2 SIMD executor, and GPU VRAM LRU cache:
            </p>
            <MoETierSimulator />
          </div>
        </details>
      )}
    </>
  )}

  <article class="prose project-prose">
    <Content />
  </article>

  <footer class="project-detail-footer">
    <div class="project-tags-section">
      <span class="project-tags-label">Technologies:</span>
      <ul class="tags-list">
        {project.data.tags.map((tag: string) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
    </div>

    <nav class="project-bottom-nav">
      <a href="/">&larr; Back to all projects</a>
      <div class="other-projects-links">
        <span style="color: var(--text-dim);">Other Projects:</span>
        {otherProjects.map((p) => (
          <a href={`/projects/${p.id}/`}>{p.data.name}</a>
        ))}
      </div>
    </nav>
  </footer>
</BaseLayout>
