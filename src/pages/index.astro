---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

import projectsData from '../data/projects.json';

const projects = projectsData.projects;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
}
---

<BaseLayout>
  <header>
    <h1>Yashwanth</h1>
    <p class="subtitle">Studying Computer Science</p>
  </header>

  <section>
    <p class="intro-text">
      I'm interested in software engineering, computer systems, and machine learning.
    </p>
  </section>

  <section class="projects">
    <h2>Projects</h2>
    <div class="projects-grid">
      {projects.map((project) => (
        <article class="project-card">
          <div class="project-header">
            <div class="project-title-wrapper">
              {project.icon && (
                <img src={project.icon} alt="" class="project-icon" width="28" height="28" loading="lazy" />
              )}
              <h3 class="project-title">
                <a href={`/projects/${project.name.toLowerCase()}/`} class="project-title-link">
                  {project.name}
                </a>
              </h3>
            </div>
            <div class="project-links">
              <a
                href={`/projects/${project.name.toLowerCase()}/`}
                class="project-overview-link"
                title={`View ${project.name} technical overview`}
              >
                Overview &rarr;
              </a>
              {project.links.map((link) => {
                const isGitHub =
                  link.label.toLowerCase() === 'github' ||
                  link.label.toLowerCase() === 'code' ||
                  link.url.includes('github.com');
                return (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={isGitHub ? "github-link" : undefined}
                    aria-label={isGitHub ? `${project.name} on GitHub` : `${project.name} ${link.label}`}
                    title={isGitHub ? "View on GitHub" : link.label}
                  >
                    {isGitHub ? (
                      <svg class="icon-github" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                      </svg>
                    ) : (
                      <>
                        {link.label} &rarr;
                      </>
                    )}
                  </a>
                );
              })}
            </div>
          </div>
          <p class="project-desc">{project.description}</p>
          <ul class="tags-list">
            {project.tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  {sortedPosts.length > 0 && (
    <section class="writing">
      <h2>Writing</h2>
      <ul class="posts-list">
        {sortedPosts.map((post) => (
          <li class="post-item">
            <div class="post-top">
              <a href={`/blog/${post.id}/`} class="post-title-link">
                {post.data.title}
              </a>
              <time datetime={post.data.pubDate.toISOString()} class="post-date">
                {formatDate(post.data.pubDate)}
              </time>
            </div>
            <p class="post-summary">{post.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="contact">
    <h2>Contact</h2>
    <ul class="contact-list">
      <li class="contact-row">
        <span>Email: <a href="mailto:yashwk@proton.me">yashwk@proton.me</a></span>
        <button class="copy-btn" id="copy-email-btn" type="button" aria-label="Copy email address" data-email="yashwk@proton.me">
          copy
        </button>
      </li>
      <li class="contact-row">
        <span>GitHub: <a href="https://github.com/yashwk" target="_blank" rel="noopener noreferrer">github.com/yashwk</a></span>
      </li>
    </ul>
  </section>

  <script>
    const copyBtn = document.getElementById('copy-email-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.getAttribute('data-email');
        if (email) {
          try {
            await navigator.clipboard.writeText(email);
            copyBtn.textContent = 'copied!';
            copyBtn.classList.add('copied');
            setTimeout(() => {
              copyBtn.textContent = 'copy';
              copyBtn.classList.remove('copied');
            }, 2000);
          } catch (e) {
            console.error('Failed to copy', e);
          }
        }
      });
    }
  </script>
</BaseLayout>
